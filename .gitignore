/backend/venv/
/frontend/.vscode/

# 环境变量（含服务器地址等本地配置，不应提交）
.env
.env.local
.env.*.local

# 前端依赖与构建产物
frontend/node_modules/
frontend/dist/

# 测试与临时文件
frontend/vitest*.log
frontend/*.log
/test_samples/

# 后端 SQLite 运行时数据库（含用户数据/敏感信息，绝不入库）
backend/nexus.db
*.db
# 会话接力状态（含房间标识派生的 key 与文档 id，属运行时数据）
backend/session_state.json
backend/session_state.json.tmp
/bakfile/
